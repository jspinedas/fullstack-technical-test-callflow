{
  "name": "@callflow/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch -r ts-node/register src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "node -r ts-node/register --test test/health.test.ts test/calls.test.ts test/webhook.test.ts",
    "test:integration": "node --env-file-if-exists=../../.env test/run-integration.mjs",
    "prisma:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy"
  },
  "dependencies": {
    "@callflow/contracts": "workspace:*",
    "@nestjs/common": "11.1.6",
    "@nestjs/core": "11.1.6",
    "@nestjs/platform-express": "11.1.6",
    "@prisma/client": "6.19.3",
    "class-validator": "0.15.1",
    "class-transformer": "0.5.1",
    "express": "5.1.0",
    "libphonenumber-js": "1.13.15",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": { "ts-node": "10.9.2", "prisma": "6.19.3", "@nestjs/testing": "11.1.6", "@types/express": "5.0.6" }
}
